{
  "manifest_version": 3,
  "name": "Aster extension smoke test",
  "version": "1.0.0",
  "description": "A minimal local extension used to verify Aster's extension loading path.",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_title": "Aster test controls",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
